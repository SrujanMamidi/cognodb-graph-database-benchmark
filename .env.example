# CognoDB Cloud Configuration
COGNODB_URI=bolt+s://<your-database-id>.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=<your-cognodb-password>

# Neo4j Community (Docker) Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# Memgraph Community (Docker) Configuration
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# FalkorDB (Docker) Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=benchmark

# Apache AGE (Docker / PostgreSQL) Configuration
AGE_HOST=localhost
AGE_PORT=5432
AGE_USER=postgres
AGE_PASSWORD=<your-age-password>
AGE_DBNAME=postgres
AGE_GRAPH=benchmark
